{
  "name": "museum-capture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Schema-driven artefact cataloguing for museum volunteers",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "dev:https": "vite --mode https",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "db:migrate": "wrangler d1 migrations apply artefact-catalogue --remote",
    "db:migrate:local": "wrangler d1 migrations apply artefact-catalogue --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "@cloudflare/workers-types": "^4.20250109.0",
    "wrangler": "^3.99.0"
  }
}
